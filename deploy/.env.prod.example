# 正式環境 .env 範例 —— 複製到部署主機 /opt/cloud-drive/.env 後填入真實值。
# 真正的 .env 只存在部署主機、不進 Git（chmod 600、root:root）。

# --- PostgreSQL ---
POSTGRES_DB=cloud_drive
POSTGRES_USER=cloud_drive
POSTGRES_PASSWORD=__請替換成高強度密碼__

# --- 後端連線（注意：asyncpg driver；密碼需與上方一致）---
DATABASE_URL=postgresql+asyncpg://cloud_drive:__請替換成高強度密碼__@postgres:5432/cloud_drive

# --- 安全（必改）---
JWT_SECRET_KEY=__請用 openssl rand -hex 32 產生__

# --- 儲存 ---
LOCAL_STORAGE_PATH=/app/storage

# --- 對外曝露：Cloudflare Tunnel（僅正式環境）---
# 於 Cloudflare Zero-Trust → Networks → Tunnels 建立 remote-managed tunnel 後取得的 token。
# 只存部署主機、不進 Git。ingress 路由（<網域> → frontend:80）在 Cloudflare 儀表板設定。
TUNNEL_TOKEN=__貼上 Cloudflare tunnel token__

# --- AI 助理（與 dev 一致：接 OpenAI 相容 gateway，後端 gemma4）---
# 無可連的模型時把 ASSISTANT_ENABLED 改回 false 即可，其餘功能照常。
ASSISTANT_ENABLED=true
EMBEDDING_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://Gemma4API.myddns101ddnsking.uk/v1
LLM_API_KEY=__貼上 gemma4 gateway 的 API key（真密鑰，只存主機）__
ASSISTANT_MODEL=gemma4
LLM_NUM_CTX=65536
LLM_TIMEOUT_SECONDS=300
LLM_KEEP_ALIVE=15m
# 時光機背景排程：單一 worker 部署可開；多 worker 須關並改外部 cron
SNAPSHOT_SCHEDULER_ENABLED=true
# Reclaims expired chunked-upload sessions. Single-process only.
UPLOAD_CLEANUP_SCHEDULER_ENABLED=true

# --- 建議設定：加密金鑰（外部模型憑證 + 分享連結網址）---
# 原本只有 per-user 外部模型需要，現在分享連結也用它保存可還原的網址。
# 未設定時：連結照樣建得起來，但「Shared by me」的複製連結會失效
# （proposal §29.2.1）。啟動時會有 warning。
# 產生方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_ENCRYPTION_KEY=__Fernet key__

# --- 選用：寄信（忘記密碼/通知）---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
