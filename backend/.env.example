APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clouddrive
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost:3000"]
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/tmp/cloud-drive-storage
MAX_UPLOAD_SIZE_BYTES=104857600

# Chunked resumable upload (proposal §27.7)
UPLOAD_CHUNK_SIZE_BYTES=8388608
MAX_CHUNKED_UPLOAD_SIZE_BYTES=5368709120
UPLOAD_SESSION_RETENTION_DAYS=7
CHUNKED_UPLOAD_THRESHOLD_BYTES=104857600
# Single-process only; with several workers use an external cron instead.
UPLOAD_CLEANUP_SCHEDULER_ENABLED=false
UPLOAD_CLEANUP_INTERVAL_HOURS=24
DEFAULT_USER_QUOTA_BYTES=16106127360

# Email / password-reset delivery.
# EMAIL_PROVIDER=console logs the reset password to the server log (default, no setup).
# EMAIL_PROVIDER=smtp sends real email — fill in the SMTP_* values below.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=your@gmail.com,
# SMTP_PASSWORD=<16-char App Password> (not your normal password; requires 2FA).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Cloud Drive <no-reply@clouddrive.local>
SMTP_USE_TLS=true

# In-app AI assistant (local Gemma via Ollama). Model source is picked by the
# user per message (local or a named external connection); see detailed-design §12.10.
ASSISTANT_ENABLED=true
LLM_BASE_URL=http://localhost:11434
ASSISTANT_MODEL=gemma4:26b
LLM_NUM_CTX=65536
LLM_TIMEOUT_SECONDS=300
# Anti-loop guards (DEC-031): generation token cap (0 = uncapped) and the
# temperature used for structured (grammar-constrained) requests.
LLM_NUM_PREDICT=2048
LLM_STRUCTURED_TEMPERATURE=0.2
# Codegen overrides the structured pin — code generation needs full sampling.
LLM_CODEGEN_TEMPERATURE=0.8
# DEC-033: the planner runs with Ollama's thinking phase off by default — E8
# showed think:false cured all repetition loops and cut planner latency ~10x
# with no measurable plan-quality loss. Codegen is deliberately excluded. Set
# false to restore planner thinking (re-run the E8 A/B if swapping in a stronger
# thinking model). LLM_DISABLE_THINKING (unset here) is the separate E8 global
# knob that forces think:false on *every* local call; the per-call planner value
# wins over it.
LLM_PLANNER_DISABLE_THINKING=true
# Conversation memory: how many recent stored messages (user + assistant) are
# replayed into the planner so follow-ups resolve references ("rename the first
# one"). 0 disables memory (single-turn). trim still caps the total by num_ctx.
ASSISTANT_HISTORY_MAX_MESSAGES=12
